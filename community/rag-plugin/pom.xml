<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.neo4j</groupId>
        <artifactId>parent</artifactId>
        <version>5.26.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>neo4j-rag-plugin</artifactId>
    <version>5.26.0</version>

    <name>Neo4j - RAG Plugin</name>
    <description>Single-call RAG retrieval: vector search + k-hop traversal</description>
    <packaging>jar</packaging>

    <properties>
        <moduleName>org.neo4j.rag</moduleName>
    </properties>

    <dependencies>
        <!-- All Neo4j internal APIs (KernelTransaction, cursors, PropertyIndexQuery, etc.) -->
        <dependency>
            <groupId>org.neo4j</groupId>
            <artifactId>neo4j</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Integration test support -->
        <dependency>
            <groupId>org.neo4j.community</groupId>
            <artifactId>it-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Neo4j test harness (Neo4jBuilders.newInProcessBuilder) -->
        <dependency>
            <groupId>org.neo4j.test</groupId>
            <artifactId>neo4j-harness</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
